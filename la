#!/usr/bin/env bash
# shellcheck source=/dev/null
#
# la.sh -- entry point for log analyser scritpt
#
#

set -euo pipefail

export VERSION="1.0.0"
PROG_NAME="$(basename "$0")" 

DATE="$(date +%Y_%m_%d)"
SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

export SCRIPT_DIR
export DATE
export PROG_NAME
export PROG_LOGS_DIR=${PROG_LOGS_DIR:-"$HOME/.local/state/$PROG_NAME/logs"}

# form user
export AI_ENABLED=0    # 0 for false | * ~ 1 for pass
export LOG_PATH=""
ALL_FILES=()


# error codes
export ERROR_WARNING=1
export ERROR_FATAL=2
export ERROR_OK=0
export ERROR_USAGE=3
export ERROR_NO_LOG=4


# log specific vars
export BAD_LOGS_COUNT=0         # logs that could not be read
export EMPTY_LOGS=0             # logs completely empty


# Severity keywords

readonly STARTUP_KEYWORDS="startup complete|initialized|ready|started"
readonly STOP_KEYWORDS='shutting down|shutdown complete|stopped|graceful'
readonly FATAL_KEYWORDS="fatal|emerg|panic"
readonly CRITICAL_KEYWORDS="crit|critical|xtreme"
readonly ERROR_KEYWORDS="error|fail|failed|failure"
readonly WARN_KEYWORDS="warn|warning|deprecated|debug"
readonly HEALTHY_KEYWORDS="healthy|okay|pass|ok|done"

export FATAL_KEYWORDS
export ERROR_KEYWORDS
export WARN_KEYWORDS
export HEALTHY_KEYWORDS
export STOP_KEYWORDS
export STARTUP_KEYWORDS
export CRITICAL_KEYWORDS



# file paths
readonly lib_path="$SCRIPT_DIR/lib"
readonly tests_path="$SCRIPT_DIR/tests"
readonly feat_path="$SCRIPT_DIR/feat"

export lib_path
export tests_path
export feat_path


declare -a _compressed_log=()


# temp file
TMP_FILE=""
export TMP_FILE

init_tmp() {
    TMP_FILE="$(mktemp)"
    readonly TMP_FILE
    trap 'rm -f "$TMP_FILE"' EXIT
}

launch_prompt() {
    read -rp "enter logs directory: " LOG_PATH || {
        error "read log path from prompt failed"
        exit $ERROR_USAGE
    }

    read -rp "enable AI-assisted verdict? (y/n): " ai_choice || {
        error "read AI choice from prompt failed"
        exit $ERROR_USAGE
    }

    [[ "$ai_choice" =~ ^[Yy]$ ]] && AI_ENABLED=1 || AI_ENABLED=0
}

# source library scripts
for script in "$lib_path"/*; do
    source "$script" || {
        error "failed to source $script"
        exit $ERROR_USAGE
    }
done

main() {
    mkdir -p "$PROG_LOGS_DIR"
    init_tmp
    parse_args "$@"
    [[ -n "$LOG_PATH" ]] || launch_prompt
    validate_dir "$LOG_PATH" || return "$ERROR_USAGE"
    get_log_files "$LOG_PATH" ALL_FILES || return "$ERROR_NO_LOG"

    tui_init
    tui_header

    local i=0 total=${#ALL_FILES[@]} file last
    for file in "${ALL_FILES[@]}"; do
        (( ++i ))
        tui_compress_progress "$i" "$total" "$(basename "$file")" "compressing..."
        compress_log "$file"
        last=""
        (( ${#_compressed_log[@]} > 0 )) && last="${_compressed_log[-1]}"
        tui_compress_progress "$i" "$total" "$(basename "$file")" "$last"
    done
    tui_compress_end

    local manual_out=""
    for file in "${ALL_FILES[@]}"; do
        manual_out+=$(analyse_log "$file")$'\n'
    done
    tui_manual "$manual_out"

    if (( AI_ENABLED )); then
        local ai_out ai_rc=0
        ai_out=$(get_ai_overview) || ai_rc=$?
        tui_ai "$ai_out" "$ai_rc"
    fi

    tui_footer
}

main "$@"